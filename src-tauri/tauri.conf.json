{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIFlow",
  "version": "0.1.0",
  "identifier": "com.sodamai.aiflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AIFlow",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost http://localhost:1420; frame-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RUJDNDVENjBFM0YzN0QKUldSOTgrTmdYY1RyZHpvYWpwdmp4cCtrZ0lMbWw3RXZtTkV6SXhEdVZac2JSdituWFpFRXRQeFgK",
      "endpoints": [
        "https://github.com/sodam-ai/ai-flow/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installer_args": ["/quiet"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}

{
  "name": "aiflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ts": "vite --port 1420",
    "dev:mock": "TAURI_MOCK=1 vite --port 1420",
    "build": "tauri build",
    "preview": "vite preview",
    "test:unit:ts": "vitest run --coverage",
    "test:unit:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "KEYCHAIN_TEST=1 playwright test",
    "test:contract": "vitest run tests/contract",
    "test:security": "cargo audit --manifest-path src-tauri/Cargo.toml && npm audit --audit-level=high",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && cargo tarpaulin --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test:security && npm run test:unit:rust && npm run test:unit:ts && npm run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.1",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.1",
    "@tauri-apps/plugin-notification": "^2.2.1",
    "@tauri-apps/plugin-store": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "clsx": "^2.1.1",
    "fast-check": "^3.23.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
